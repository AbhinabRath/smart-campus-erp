generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Department {
  id                 String              @id @default(cuid())
  name               String              @unique
  code               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendanceSessions AttendanceSession[]
  students           Student[]
  subjects           Subject[]
  teachers           Teacher[]
  timetables         Timetable[]

  @@map("departments")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  password         String
  name             String
  role             String
  avatar           String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  approvedLeaves   LeaveRequest[]   @relation("LeaveApprover")
  leaveRequests    LeaveRequest[]
  noticeReads      NoticeRead[]
  publishedNotices Notice[]
  recommendations  Recommendation[]
  sessions         Session[]
  student          Student?
  teacher          Teacher?
  passwordResetRequests PasswordResetRequest[]
  @@index([email])
  @@index([role])
  @@map("users")
}

model Student {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  rollNumber            String                 @unique
  semester              Int
  departmentId          String
  section               String                 @default("A")
  academicYear          String
  phoneNumber           String?
  guardianName          String?
  guardianPhone         String?
  admissionYear         Int?
  collegeEmail          String?
  bio                   String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  assignmentSubmissions AssignmentSubmission[]
  attendanceRecords     AttendanceRecord[]
  fee_payments          fee_payments[]
  marks                 Mark[]
  department            Department             @relation(fields: [departmentId], references: [id], onDelete: NoAction)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rollNumber])
  @@index([departmentId])
  @@index([semester])
  @@map("students")
}

model Teacher {
  id                 String              @id @default(cuid())
  userId             String              @unique
  employeeId         String              @unique
  departmentId       String
  specialization     String?
  designation        String              @default("Assistant Professor")
  phoneNumber        String?
  qualification      String?
  officeRoom         String?
  bio                String?
  researchArea       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        Assignment[]
  attendanceSessions AttendanceSession[]
  marksEntries       Mark[]
  studyMaterials     StudyMaterial[]
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: NoAction)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetables         Timetable[]

  @@index([employeeId])
  @@index([departmentId])
  @@map("teachers")
}

model Subject {
  id                 String              @id @default(cuid())
  name               String
  code               String              @unique
  departmentId       String
  semester           Int
  credits            Int                 @default(3)
  type               String              @default("theory")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        Assignment[]
  attendanceSessions AttendanceSession[]
  marks              Mark[]
  studyMaterials     StudyMaterial[]
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: NoAction)
  timetables         Timetable[]

  @@index([code])
  @@index([departmentId])
  @@index([semester])
  @@map("subjects")
}

model AttendanceSession {
  id                   String             @id @default(cuid())
  teacherId            String
  subjectId            String
  departmentId         String
  semester             Int
  section              String             @default("A")
  qrCode               String             @unique
  currentQrToken       String?            @db.VarChar(255)
  tokenExpiresAt       DateTime?
  tokenRotationSec     Int                @default(10)
  allowedNetworkPrefix String?            @db.VarChar(50)
  latitude             Float?
  longitude            Float?
  allowedRadius        Int                @default(25)
  isActive             Boolean            @default(true)
  duration             Int                @default(15)
  startedAt            DateTime           @default(now())
  endedAt              DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  records              AttendanceRecord[]
  department           Department         @relation(fields: [departmentId], references: [id], onDelete: NoAction)
  subject              Subject            @relation(fields: [subjectId], references: [id], onDelete: NoAction)
  teacher              Teacher            @relation(fields: [teacherId], references: [id], onDelete: NoAction)

  @@index([qrCode])
  @@index([isActive])
  @@index([teacherId])
  @@index([subjectId])
  @@index([departmentId], map: "attendance_sessions_departmentId_fkey")
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  studentId           String
  attendanceSessionId String
  markedAt            DateTime          @default(now())
  ipAddress           String?
  tokenUsed           String?           @db.VarChar(255)
  deviceInfo          String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  session             AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student             Student           @relation(fields: [studentId], references: [id], onDelete: NoAction)

  @@unique([studentId, attendanceSessionId])
  @@index([studentId])
  @@index([attendanceSessionId])
  @@map("attendance_records")
}

model Mark {
  id            String   @id @default(cuid())
  studentId     String
  subjectId     String
  teacherId     String
  examType      String
  marksObtained Float
  totalMarks    Float
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  student       Student  @relation(fields: [studentId], references: [id], onDelete: NoAction)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: NoAction)
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: NoAction)

  @@unique([studentId, subjectId, teacherId, examType])
  @@index([studentId])
  @@index([subjectId])
  @@index([examType])
  @@index([teacherId], map: "marks_teacherId_fkey")
  @@map("marks")
}

model Assignment {
  id          String                 @id @default(cuid())
  teacherId   String
  subjectId   String
  title       String
  description String
  deadline    DateTime
  filePath    String?
  fileName    String?
  maxMarks    Float                  @default(100)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  submissions AssignmentSubmission[]
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: NoAction)
  teacher     Teacher                @relation(fields: [teacherId], references: [id], onDelete: NoAction)

  @@index([teacherId])
  @@index([subjectId])
  @@index([deadline])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String     @id @default(cuid())
  assignmentId  String
  studentId     String
  filePath      String?
  fileName      String?
  content       String?
  submittedAt   DateTime   @default(now())
  status        String     @default("submitted")
  marksObtained Float?
  feedback      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: NoAction)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model StudyMaterial {
  id          String   @id @default(cuid())
  teacherId   String
  subjectId   String
  title       String
  description String?
  filePath    String
  fileName    String
  fileType    String
  fileSize    Int
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: NoAction)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: NoAction)

  @@index([teacherId])
  @@index([subjectId])
  @@index([fileType])
  @@map("study_materials")
}

model Timetable {
  id           String     @id @default(cuid())
  departmentId String
  semester     Int
  section      String     @default("A")
  dayOfWeek    Int
  periodNumber Int
  subjectId    String
  teacherId    String
  roomNumber   String
  startTime    String
  endTime      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: NoAction)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: NoAction)
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: NoAction)

  @@unique([departmentId, semester, section, dayOfWeek, periodNumber])
  @@index([departmentId])
  @@index([teacherId])
  @@index([subjectId], map: "timetables_subjectId_fkey")
  @@map("timetables")
}

model Notice {
  id         String       @id @default(cuid())
  authorId   String
  title      String
  content    String
  targetRole String       @default("all")
  priority   String       @default("normal")
  isPinned   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  reads      NoticeRead[]
  author     User         @relation(fields: [authorId], references: [id], onDelete: NoAction)

  @@index([targetRole])
  @@index([priority])
  @@index([createdAt])
  @@index([authorId], map: "notices_authorId_fkey")
  @@map("notices")
}

model NoticeRead {
  id       String   @id @default(cuid())
  userId   String
  noticeId String
  readAt   DateTime @default(now())
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([userId])
  @@index([noticeId])
  @@map("notice_reads")
}

model LeaveRequest {
  id         String   @id @default(cuid())
  userId     String
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String   @default("pending")
  approvedBy String?
  comments   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  approver   User?    @relation("LeaveApprover", fields: [approvedBy], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([status])
  @@index([approvedBy], map: "leave_requests_approvedBy_fkey")
  @@map("leave_requests")
}

model Recommendation {
  id          String   @id @default(cuid())
  studentId   String
  type        String
  title       String
  description String
  actionUrl   String?
  priority    String   @default("medium")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [studentId], references: [id], onDelete: NoAction)

  @@index([studentId])
  @@index([type])
  @@index([isRead])
  @@map("recommendations")
}

model AcademicDocument {
  id         String   @id @default(cuid())
  year       Int
  type       String
  fileName   String
  filePath   String
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([year])
  @@index([type])
  @@map("academic_documents")
}

model AcademicCalendar {
  id         String   @id @default(cuid())
  fileName   String
  filePath   String
  uploadedBy String
  createdAt  DateTime @default(now())

  @@map("academic_calendars")
}

model RegulationDocument {
  id         String   @id @default(cuid())
  fileName   String
  filePath   String
  uploadedBy String
  createdAt  DateTime @default(now())

  @@map("regulation_documents")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

enum PasswordResetStatus {
  PENDING
  APPROVED
  REJECTED
  USED
}

model PasswordResetRequest {
  id            String              @id @default(cuid())

  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  status        PasswordResetStatus @default(PENDING)

  requestedAt   DateTime            @default(now())
  handledAt     DateTime?

  handledById   String?
  handledByName String?

  oneTimeLogin  Boolean             @default(false)
  used          Boolean             @default(false)

  @@index([userId])
  @@index([status])

  @@map("password_reset_requests")
}

model BrandingSettings {
  id              String   @id @default(cuid())
  loginBackground String?
  updatedAt       DateTime @updatedAt

  @@map("branding_settings")
}

model fee_payments {
  id          String    @id
  studentId   String
  semester    Int
  amountPaid  Decimal   @default(0.00) @db.Decimal(10, 2)
  remarks     String?   @db.VarChar(255)
  paymentDate DateTime? @default(now())
  createdAt   DateTime? @default(now())
  students    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fee_student")

  @@index([studentId], map: "idx_student")
}

model fee_structure {
  id         String    @id
  semester   Int       @unique(map: "semester")
  tuitionFee Decimal   @default(0.00) @db.Decimal(10, 2)
  hostelFee  Decimal   @default(0.00) @db.Decimal(10, 2)
  examFee    Decimal   @default(0.00) @db.Decimal(10, 2)
  libraryFee Decimal   @default(0.00) @db.Decimal(10, 2)
  miscFee    Decimal   @default(0.00) @db.Decimal(10, 2)
  totalFee   Decimal   @db.Decimal(10, 2)
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now())
}
